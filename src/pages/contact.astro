---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TrialSection from '../components/TrialSection.astro';
import Visit from '../components/Visit.astro';
import { business, waLink, faqs } from '../data/site';
---
<Base title="Gym in Gulistan e Johar: Directions | Hanma Fitness" description="Find Hanma Fitness Studio on Manzoor Street, Gulistan e Johar, Karachi, and book a free session. WhatsApp 0316 7911505, directions and opening hours." faq={faqs}>
  <PageHero crumbs={[{ name: 'Visit', href: '/contact' }]} eyebrow="Contact" title="Book a Free Session" lede="The fastest way is WhatsApp. Humaira replies on WhatsApp until 10:30 pm.">
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-gold" href={waLink('Hi Hanma, I would like to book a free session')} data-wa data-track="contact_whatsapp">WhatsApp {business.phoneDisplay}</a>
      <a class="btn btn-line" href={`tel:${business.phoneTel}`}>Call Us</a>
    </div>
  </PageHero>
  <TrialSection heading="Or Tell Us Here" />
  <Visit />
</Base>
