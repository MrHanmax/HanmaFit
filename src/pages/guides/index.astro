---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { guides } from '../../data/guides';
---
<Base title="Gym Guides for Gulistan e Johar | Hanma Fitness" description="Straight answers before you join a gym in Gulistan e Johar, Karachi: gym fees, choosing a ladies gym and what a personal trainer should do.">
  <PageHero crumbs={[{ name: 'Guides', href: '/guides' }]} eyebrow="Guides" title="Before You Join a Gym" lede="Straight answers to what people in Gulistan e Johar ask us most, from the coaches at Hanma." />
  <section class="pb-16 md:pb-24">
    <ul class="wrap grid gap-4 md:grid-cols-3">
      {guides.map((g) => (
        <li><a href={`/guides/${g.slug}`} class="block h-full rounded-[2px] border border-line bg-raised p-6 transition-colors hover:border-gold">
          <span class="block text-[1.75rem] leading-tight font-[family-name:var(--font-serif)]">{g.title}</span>
          <span class="mt-3 block text-muted">{g.description}</span>
          <span class="cond mt-5 block text-[0.85rem] font-semibold uppercase tracking-[0.14em] text-gold">Read the guide</span>
        </a></li>
      ))}
    </ul>
  </section>
</Base>
