---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PriceTable from '../components/PriceTable.astro';
import TrialSection from '../components/TrialSection.astro';
import { waLink } from '../data/site';
---
<Base title="Gym Fees in Gulistan e Johar, Karachi | Hanma Fitness" description="Gym fees in Gulistan e Johar: personal training 20,000, group 12,000, basic 7,000 a month. Quarterly plans save up to 29%, no admission.">
  <PageHero crumbs={[{ name: 'Prices', href: '/pricing' }]} eyebrow="Prices" title="Every Price, Upfront" lede="Quarterly plans save up to 29% and skip the admission fee.">
    <div class="mt-8"><a class="btn btn-gold" href={waLink('Hi Hanma, I have a question about prices')} data-wa data-track="pricing_whatsapp">Ask About a Plan on WhatsApp</a></div>
  </PageHero>
  <section class="pb-16 md:pb-24"><div class="wrap max-w-5xl"><PriceTable /></div></section>
  <TrialSection heading="Try Before You Pay" />
</Base>
