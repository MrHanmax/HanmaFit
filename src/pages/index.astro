---
import Base from '../layouts/Base.astro';
import FloorNow from '../components/FloorNow';
import CoachStrip from '../components/CoachStrip';
import ProgrammeList from '../components/ProgrammeList.astro';
import Results from '../components/Results.astro';
import TrialSection from '../components/TrialSection.astro';
import Visit from '../components/Visit.astro';
import { img, studioPhotos, waLink, faqs, business } from '../data/site';
---
<Base
  title="Hanma Fitness Studio | Coached Gym in Gulistan e Johar, Karachi"
  description="A coaching first gym in Gulistan e Johar, Karachi. Personal training, group training, women only hours, MMA and physio. Your first session is free."
  faq={faqs}
>
  <!-- Hero: the promise, and what is happening on the floor right now -->
  <section class="pt-10 pb-14 md:pt-16 md:pb-20">
    <div class="wrap grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-14">
      <div>
        <h1 class="text-[3.6rem] sm:text-7xl lg:text-[6.2rem]">Train with a coach, not just a membership.</h1>
        <p class="mt-6 max-w-xl text-lg text-steel md:text-xl">Strength training, women only afternoons, MMA and physio in Gulistan e Johar. Train your first session free and leave with a plan.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="btn btn-wa" href={waLink('Hi Hanma, I would like to book a free session')} data-wa data-track="hero_whatsapp">Book a free session on WhatsApp</a>
          <a class="btn btn-ghost" href="/pricing">See prices</a>
        </div>
        <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-steel">
          <a href={business.mapsUrl} class="inline-flex items-center gap-1.5 font-semibold text-iron hover:underline underline-offset-4">
            <span class="text-gold-ink" aria-hidden="true">★★★★★</span> {business.googleRating} on Google, {business.googleReviewCount} reviews
          </a>
          <span>Quarterly plans have no admission fee.</span>
        </p>
      </div>
      <FloorNow client:load />
    </div>
  </section>

  <!-- Real photos of the studio, not stock -->
  <section aria-label="Inside the studio" class="pb-16 md:pb-24">
    <div class="wrap grid grid-cols-6 gap-3 md:gap-4">
      <img src={img(studioPhotos.hero)} alt="The Hanma strength floor" class="col-span-6 aspect-[16/9] w-full rounded-[1.75rem] object-cover md:col-span-4 md:aspect-auto md:h-full" />
      <div class="col-span-6 grid grid-cols-2 gap-3 md:col-span-2 md:grid-cols-1 md:gap-4">
        <img src={img(studioPhotos.session)} alt="A coached session at Hanma" loading="lazy" class="aspect-square w-full rounded-[1.75rem] object-cover md:aspect-[4/3]" />
        <img src={img(studioPhotos.weights)} alt="Free weights area" loading="lazy" class="aspect-square w-full rounded-[1.75rem] object-cover md:aspect-[4/3]" />
      </div>
    </div>
  </section>

  <section class="pb-16 md:pb-24">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-5xl md:text-7xl">Choose how you train</h2>
        <a href="/pricing" class="font-semibold underline underline-offset-4">Full price list</a>
      </div>
      <div class="mt-8"><ProgrammeList /></div>
    </div>
  </section>

  <section class="bg-iron py-16 text-chalk md:py-24">
    <div class="wrap">
      <h2 class="max-w-3xl text-5xl md:text-7xl">Members who stuck with it</h2>
      <p class="mt-4 max-w-xl text-chalk/70">Real Hanma members and their own results.</p>
      <div class="mt-10"><Results /></div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap">
      <h2 class="text-5xl md:text-7xl">How your free session works</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        <li class="border-t-4 border-gold pt-5">
          <p class="price text-5xl">1</p>
          <h3 class="mt-2 text-3xl">Tell us your goal</h3>
          <p class="mt-2 text-steel">Message us on WhatsApp or use the form. Fat loss, strength, women only, MMA or an injury, all fine.</p>
        </li>
        <li class="border-t-4 border-gold pt-5">
          <p class="price text-5xl">2</p>
          <h3 class="mt-2 text-3xl">Train with a coach</h3>
          <p class="mt-2 text-steel">One full session on the floor. Your coach checks how you move and where you're starting from.</p>
        </li>
        <li class="border-t-4 border-gold pt-5">
          <p class="price text-5xl">3</p>
          <h3 class="mt-2 text-3xl">Leave with a plan</h3>
          <p class="mt-2 text-steel">You get a clear recommendation for your goal and budget. Join that day, or think it over.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="pb-16 md:pb-24" aria-labelledby="coaches-h">
    <div class="wrap flex flex-wrap items-end justify-between gap-4">
      <h2 id="coaches-h" class="text-5xl md:text-7xl">Your coaches</h2>
      <a href="/about" class="font-semibold underline underline-offset-4">Meet the team</a>
    </div>
    <div class="mt-8"><CoachStrip client:visible /></div>
  </section>

  <TrialSection />
  <Visit />
</Base>
