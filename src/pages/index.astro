---
import Base from '../layouts/Base.astro';
import FloorNow from '../components/FloorNow';
import CoachStrip from '../components/CoachStrip';
import ProgrammeList from '../components/ProgrammeList.astro';
import Results from '../components/Results.astro';
import TrialSection from '../components/TrialSection.astro';
import Visit from '../components/Visit.astro';
import SectionHead from '../components/SectionHead.astro';
import { img, studioPhotos, waLink, faqs, business } from '../data/site';
---
<Base
  title="Best Gym in Gulistan e Johar, Karachi | Hanma Fitness Studio"
  description="Hanma Fitness Studio is a coached gym in Gulistan e Johar, Karachi, rated 4.7 on Google. Personal training, group training, a ladies gym every afternoon, MMA and physio. First session free."
  faq={faqs}
>
  <!-- Hero: the studio floor itself, with what is on right now -->
  <section class="relative isolate overflow-hidden">
    <img src={img(studioPhotos.hero)} alt="" width="1600" height="1064" class="absolute inset-0 -z-20 h-full w-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 -z-10 bg-ink/80" aria-hidden="true"></div>
    <div class="wrap grid gap-12 py-14 md:py-24 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <h1>
          <span class="eyebrow block">Best gym in Gulistan e Johar, Karachi</span>
          <span class="rule-under mt-6 block text-[3.6rem] leading-[0.95] sm:text-7xl lg:text-[5.75rem]">Train With a Coach, Not Just a Membership.</span>
        </h1>
        <p class="dek mt-6 max-w-xl text-xl">Strength, a ladies gym every afternoon, MMA and physio under one roof. Your first session is free, and you leave it with a plan.</p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="btn btn-gold" href={waLink('Hi Hanma, I would like to book a free session')} data-wa data-track="hero_whatsapp">Book a Free Session</a>
          <a class="btn btn-line" href="/pricing">See Prices</a>
        </div>
      </div>
      <FloorNow client:load />
    </div>
  </section>

  <!-- Proof strip: the four things people check before they visit -->
  <section aria-label="Why members choose Hanma" class="border-b border-line bg-raised">
    <ul class="wrap grid grid-cols-2 gap-x-6 gap-y-5 py-7 md:grid-cols-4">
      <li><a href={business.mapsUrl} class="block"><span class="price block text-3xl text-gold">{business.googleRating} ★</span><span class="text-sm text-muted">{business.googleReviewCount} Google reviews</span></a></li>
      <li><span class="price block text-3xl text-gold">Since 2023</span><span class="text-sm text-muted">Coaching in Gulistan e Johar</span></li>
      <li><span class="price block text-3xl text-gold">1 to 5 pm</span><span class="text-sm text-muted">Women only, every day but Sunday</span></li>
      <li><span class="price block text-3xl text-gold">Free</span><span class="text-sm text-muted">First session, no admission on quarterly plans</span></li>
    </ul>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap">
      <SectionHead eyebrow="Programmes" title="Choose How You Train" dek="Personal training, group training, a ladies gym, MMA and physio in Gulistan e Johar. Not sure which fits? Your free session settles it." />
      <div class="mt-10"><ProgrammeList /></div>
      <p class="mt-6"><a href="/pricing" class="font-semibold underline decoration-gold decoration-2 underline-offset-[6px]">See the full price list</a></p>
    </div>
  </section>

  <!-- Real photos of the studio -->
  <section aria-label="Inside the studio" class="pb-16 md:pb-24">
    <div class="wrap grid grid-cols-2 gap-3 md:grid-cols-3">
      <img src={img(studioPhotos.session)} alt="Coached strength session at Hanma, a gym in Gulistan e Johar" loading="lazy" class="col-span-2 aspect-[16/10] w-full rounded-[2px] object-cover md:col-span-2 md:row-span-2 md:aspect-auto md:h-full" />
      <img src={img(studioPhotos.weights)} alt="The free weights area" loading="lazy" class="aspect-square w-full rounded-[2px] object-cover md:aspect-[4/3]" />
      <img src={img(studioPhotos.strength)} alt="The functional training floor" loading="lazy" class="aspect-square w-full rounded-[2px] object-cover md:aspect-[4/3]" />
    </div>
  </section>

  <section class="pb-16 md:pb-24" aria-labelledby="why-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <SectionHead id="why-h" eyebrow="Why Hanma" title="What Makes a Gym the Best in Gulistan e Johar" />
      <div class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
        <div><h3 class="text-2xl">A Coach on the Floor</h3><p class="mt-2 text-muted">Morning, afternoon and evening sessions are coached. You are corrected, progressed and kept accountable, not left with a membership card.</p></div>
        <div><h3 class="text-2xl">A Ladies Gym Every Afternoon</h3><p class="mt-2 text-muted">From 1 to 5 pm the whole studio is women only, with a female coach. <a class="text-cream underline decoration-gold underline-offset-4" href="/services/women-only">See women only sessions</a>.</p></div>
        <div><h3 class="text-2xl">Physio and Nutrition In House</h3><p class="mt-2 text-muted">Dr Ismail handles injuries and rehab. Diet plans come from a team led by a qualified nutritionist. <a class="text-cream underline decoration-gold underline-offset-4" href="/services/hanma-health">See Hanma Health</a>.</p></div>
        <div><h3 class="text-2xl">Rated {business.googleRating} on Google</h3><p class="mt-2 text-muted">{business.googleReviewCount} reviews from members in Johar since we opened in 2023. <a class="text-cream underline decoration-gold underline-offset-4" href={business.mapsUrl}>Read them on Google</a>.</p></div>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-raised py-16 md:py-24">
    <div class="wrap">
      <SectionHead eyebrow="Results" title="Members Who Stuck With It" dek="Real Hanma members and their own results." />
      <div class="mt-10"><Results /></div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="wrap">
      <SectionHead eyebrow="Your free session" title="How It Works" dek="One coached session. No payment, no pressure." />
      <ol class="mt-10 grid gap-4 md:grid-cols-3">
        <li class="rounded-[2px] border border-line bg-raised p-6">
          <p class="numeral text-5xl">01</p>
          <h3 class="mt-4 text-3xl">Tell Us Your Goal</h3>
          <p class="mt-2 text-muted">Message us on WhatsApp or use the form. Fat loss, strength, women only, MMA or an injury, all fine.</p>
        </li>
        <li class="rounded-[2px] border border-line bg-raised p-6">
          <p class="numeral text-5xl">02</p>
          <h3 class="mt-4 text-3xl">Train With a Coach</h3>
          <p class="mt-2 text-muted">One full session on the floor. Your coach checks how you move and where you are starting from.</p>
        </li>
        <li class="rounded-[2px] border border-line bg-raised p-6">
          <p class="numeral text-5xl">03</p>
          <h3 class="mt-4 text-3xl">Leave With a Plan</h3>
          <p class="mt-2 text-muted">A clear recommendation for your goal and budget. Join that day, or think it over.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="pb-16 md:pb-24" aria-labelledby="coaches-h">
    <div class="wrap flex flex-wrap items-end justify-between gap-4">
      <SectionHead id="coaches-h" eyebrow="The team" title="Your Coaches" />
      <a href="/about" class="font-semibold underline decoration-gold decoration-2 underline-offset-[6px]">Meet the team</a>
    </div>
    <div class="mt-10"><CoachStrip client:visible /></div>
  </section>

  <TrialSection />
  <Visit />
</Base>
