---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import TrialSection from '../components/TrialSection.astro';
import { coaches, img, studioPhotos } from '../data/site';
---
<Base title="Coaches | Hanma Fitness Studio, Gulistan e Johar" description="Meet the coaches at Hanma Fitness Studio in Gulistan e Johar: strength, women's, MMA and physiotherapy, led by founder Fawad Haris.">
  <PageHero title="The people coaching you" lede="Hanma started with one idea: people get results when someone is actually coaching them. Here's who that is." />

  <section class="pb-16 md:pb-24">
    <div class="wrap grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {coaches.map((c) => (
        <article>
          {c.photo
            ? <img src={img(c.photo)} alt={c.name} loading="lazy" class="aspect-[4/5] w-full rounded-[1.75rem] object-cover" />
            : <div class="flex aspect-[4/5] w-full items-end rounded-[1.75rem] bg-iron p-6"><span class="font-display text-8xl font-extrabold text-chalk/90" aria-hidden="true">{c.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}</span></div>}
          <h2 class="mt-4 text-4xl">{c.name}</h2>
          <p class="font-semibold">{c.role}{c.hours && <span class="font-normal text-steel">, {c.hours}</span>}</p>
          <p class="mt-2 text-steel">{c.bio}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-chalk py-16 md:py-24">
    <div class="wrap grid gap-10 lg:grid-cols-2 lg:items-center">
      <img src={img(studioPhotos.community)} alt="Members training together at Hanma" loading="lazy" class="w-full rounded-[1.75rem] object-cover" />
      <div class="prose-hanma max-w-xl text-lg">
        <h2 class="mb-6 text-5xl">Why Hanma is built around coaching</h2>
        <p>Most gyms sell you access and leave you to it. We'd rather sell you results, so every programme starts with a coach who knows your name, your goal and your starting point.</p>
        <p>The studio has a strength floor, a separate class room for MMA and aerobics, and a physio room, so different kinds of training don't get in each other's way.</p>
        <p>Women only hours run every afternoon, Monday to Saturday.</p>
      </div>
    </div>
  </section>

  <TrialSection showFaq={false} heading="Meet them in person" />
</Base>
