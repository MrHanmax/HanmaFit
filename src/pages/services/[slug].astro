---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import TrialSection from '../../components/TrialSection.astro';
import { programmes, img, waLink, type Programme } from '../../data/site';

export function getStaticPaths() {
  return programmes.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Programme };
const others = programmes.filter((o) => o.slug !== p.slug);
const guideFor: Record<string, { href: string; label: string }> = {
  'women-only': { href: '/guides/ladies-gym-gulistan-e-johar', label: 'Guide: how to choose a ladies gym in Gulistan e Johar' },
  'personal-training': { href: '/guides/personal-trainer-karachi-first-month', label: 'Guide: what your first month with a personal trainer should look like' },
};
const guide = guideFor[p.slug] ?? { href: '/guides/gym-fees-gulistan-e-johar', label: 'Guide: gym fees in Gulistan e Johar, explained' };
---
<Base title={p.title} description={p.description}>
  <PageHero crumbs={[{ name: 'Programmes', href: '/services' }, { name: p.name, href: `/services/${p.slug}` }]} eyebrow={p.tone === 'women' ? 'Women only · Programme' : 'Programme'} title={p.name} lede={p.short}>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-gold" href={waLink(`Hi Hanma, I would like a free session for ${p.name.toLowerCase()}`)} data-wa data-track={`programme_${p.slug}_whatsapp`}>Book a Free Session</a>
      <a class="btn btn-line" href="/pricing">See All Prices</a>
    </div>
  </PageHero>

  <section class="pb-16 md:pb-24">
    <div class="wrap grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <dl class="grid gap-6 border-y border-line py-6 sm:grid-cols-3">
          <div><dt class="cond text-[0.85rem] font-semibold uppercase tracking-[0.14em] text-gold">When</dt><dd class="mt-1 font-semibold">{p.when}</dd></div>
          <div><dt class="cond text-[0.85rem] font-semibold uppercase tracking-[0.14em] text-gold">Who it suits</dt><dd class="mt-1 font-semibold">{p.who}</dd></div>
          <div><dt class="cond text-[0.85rem] font-semibold uppercase tracking-[0.14em] text-gold">From</dt><dd class="mt-1 price text-3xl">{p.from}</dd></div>
        </dl>
        <div class="prose-hanma mt-8 max-w-2xl text-lg">
          {p.intro.map((t) => <p>{t}</p>)}
        </div>
        <p class="eyebrow mt-12">Included</p><h2 class="mt-4 text-4xl">What You Get</h2>
        <ul class="mt-4 grid gap-3">
          {p.includes.map((i) => (
            <li class="flex gap-3"><span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-gold" aria-hidden="true"></span><span>{i}</span></li>
          ))}
        </ul>
        <p class="mt-8"><a href={guide.href} class="font-semibold underline decoration-gold decoration-2 underline-offset-[6px]">{guide.label}</a></p>
      </div>
      {p.video && (
        <video src={p.video.src} poster={p.video.poster} autoplay muted loop playsinline preload="metadata" aria-label={p.video.label} width="540" height="960" class="mx-auto w-full max-w-sm rounded-[2px] border border-line object-cover lg:aspect-[9/16]"></video>
      )}
      {!p.video && p.photo && <img src={img(p.photo)} alt={`${p.name} at Hanma Fitness Studio`} class="w-full rounded-[2px] object-cover lg:aspect-[4/5]" loading="lazy" />}
    </div>
  </section>

  <TrialSection goal={p.goal} heading={`Try ${p.name} Free`} />

  <section class="py-16 md:py-20">
    <div class="wrap">
      <p class="eyebrow">More</p><h2 class="mt-4 text-4xl">Other Ways to Train</h2>
      <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2">
        {others.map((o) => <li><a class="text-lg font-semibold underline underline-offset-4" href={`/services/${o.slug}`}>{o.name}</a> <span class="text-muted">from {o.from}</span></li>)}
      </ul>
    </div>
  </section>
</Base>
