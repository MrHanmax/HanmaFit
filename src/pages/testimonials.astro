---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Results from '../components/Results.astro';
import TrialSection from '../components/TrialSection.astro';
import { business } from '../data/site';
---
<Base title="Gym Results in Gulistan e Johar | Hanma Fitness Studio Members" description="Real transformations from Hanma Fitness Studio members in Gulistan e Johar, Karachi: Talal, Amna and Nabeel.">
  <PageHero crumbs={[{ name: 'Results', href: '/testimonials' }]} eyebrow="Results" title="Results From Real Members" lede="No stock photos and no invented names. These are Hanma members, in their own words." />
  <section class="pb-16 md:pb-24">
    <div class="wrap">
      <Results />
      <p class="mt-10 text-muted">More from our members on <a class="font-semibold text-cream underline decoration-gold decoration-2 underline-offset-[6px]" href={business.mapsUrl}>Google</a> and <a class="font-semibold text-cream underline decoration-gold decoration-2 underline-offset-[6px]" href={business.instagram}>Instagram</a>.</p>
    </div>
  </section>
  <TrialSection heading="Start Your Own" showFaq={false} />
</Base>
