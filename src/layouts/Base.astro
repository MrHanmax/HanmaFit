---
import '../styles/global.css';
import { business, img, studioPhotos, waLink, hoursSummary, schedule, pricing, coaches, programmes } from '../data/site';
import LeadPrompts from '../components/LeadPrompts';
import TickerBand from '../components/TickerBand.astro';

interface Props {
  noindex?: boolean;
  title: string;
  description: string;
  image?: string;
  faq?: { q: string; a: string }[];
}
const { title, description, image, faq, noindex } = Astro.props;
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/(.)\/$/, '$1');
const canonical = cleanPath === '/' ? 'https://hanmafit.com' : `https://hanmafit.com${cleanPath}`;
const ogImage = image ?? 'https://hanmafit.com/brand/og.jpg';
const path = cleanPath;

const nav = [
  { href: '/services', label: 'Programmes' },
  { href: '/pricing', label: 'Prices' },
  { href: '/about', label: 'Coaches' },
  { href: '/testimonials', label: 'Results' },
  { href: '/contact', label: 'Visit' },
];

const offers = pricing.flatMap((g) => g.items.filter((i) => i.monthly || i.once).map((i) => ({
  '@type': 'Offer',
  name: i.name,
  price: i.monthly ?? i.once,
  priceCurrency: 'PKR',
  ...(i.monthly ? { priceSpecification: { '@type': 'UnitPriceSpecification', price: i.monthly, priceCurrency: 'PKR', unitText: 'MONTH' } } : {}),
})));
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  '@id': 'https://hanmafit.com/#gym',
  name: business.name,
  alternateName: ['Hanma', 'Hanma Gym', 'Hanma Fitness', 'Hanma Fitness Studio Gulistan e Johar'],
  description: 'Coaching first gym in Gulistan e Johar, Karachi: personal training, group training, women only hours, MMA, physiotherapy and nutrition.',
  image: ['https://hanmafit.com/brand/og.jpg', `https://hanmafit.com${img(studioPhotos.hero)}`],
  logo: 'https://hanmafit.com/brand/logo.png',
  url: 'https://hanmafit.com',
  telephone: business.phoneTel,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Manzoor Street, Gulistan e Johar',
    addressLocality: 'Karachi',
    addressRegion: 'Sindh',
    addressCountry: 'PK',
  },
  geo: { '@type': 'GeoCoordinates', latitude: business.lat, longitude: business.lng },
  hasMap: business.mapsUrl,
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'], opens: '07:00', closes: '11:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'], opens: '13:00', closes: '23:59' },
  ],
  priceRange: 'PKR 1,000 to PKR 20,000',
  currenciesAccepted: 'PKR',
  foundingDate: '2023',
  founder: { '@type': 'Person', name: 'Fawad Haris', jobTitle: 'Founder and head coach', hasCredential: 'BS Human Nutrition and Dietetics' },
  employee: coaches.map((c) => ({ '@type': 'Person', name: c.name, jobTitle: c.role })),
  areaServed: [
    { '@type': 'Place', name: 'Gulistan e Johar, Karachi' },
    { '@type': 'Place', name: 'Gulistan e Jauhar, Karachi' },
    { '@type': 'Place', name: 'Gulshan e Iqbal, Karachi' },
    { '@type': 'City', name: 'Karachi' },
  ],
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Women only hours, 1 pm to 5 pm, Monday to Friday', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Female coaches', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Separate class room for MMA and aerobics', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'In house physiotherapy room', value: true },
  ],
  knowsAbout: ['Personal training', 'Strength training', 'Fat loss', 'Women only training', 'Aerobics', 'Zumba', 'MMA', 'Physiotherapy', 'Nutrition'],
  makesOffer: offers,
  sameAs: [business.instagram, business.mapsUrl],
};
const faqSchema = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>if ('IntersectionObserver' in window) document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f4f0e4" />
    <link rel="icon" type="image/png" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hanma Fitness Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_PK" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="geo.region" content="PK-SD" />
    <meta name="geo.placename" content="Gulistan e Johar, Karachi" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&family=Caveat:wght@400&display=swap" rel="stylesheet" />

    <!-- Google tag: Analytics (G-HS7N64H2QT) and linked Google tag (GT-TQDRWV76), carried over unchanged -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HS7N64H2QT"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HS7N64H2QT');
      gtag('config', 'GT-TQDRWV76');
    </script>

    <!-- Brevo tracking, carried over unchanged -->
    <script src="https://cdn.brevo.com/js/sdk-loader.js" defer></script>
    <script is:inline>
      window.Brevo = window.Brevo || [];
      Brevo.push(["init", { client_key: "zp3w0mmfoftks2602apwx958", track_page_view: true, track_utm: true }]);
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-paper focus:text-ink focus:px-4 focus:py-2">Skip to content</a>

    <TickerBand variant="top" />

    <header class="paper sticky top-0 z-40 border-b border-rule bg-paper text-ink">
      <div class="wrap flex h-[5rem] items-center justify-between gap-4">
        <a href="/" class="shrink-0" aria-label="Hanma Fitness Studio, home">
          <img src="/brand/logo.png" alt="Hanma Fitness Studio" width="96" height="58" class="h-[3.6rem] w-auto" />
        </a>
        <nav class="cond hidden lg:flex items-center gap-8 text-[1rem] font-semibold uppercase tracking-[0.12em]" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class:list={['py-2', path.startsWith(n.href) ? 'text-ink underline decoration-gold decoration-[3px] underline-offset-[10px]' : 'text-stone hover:text-ink']}>{n.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          <a href="/contact#trial" class="btn btn-gold !min-h-11 !px-5 text-base hidden sm:inline-flex" data-track="header_trial">Book a Free Session</a>
          <details class="lg:hidden relative">
            <summary class="cond list-none cursor-pointer rounded-[2px] border border-ink px-4 py-2 text-[0.95rem] font-semibold uppercase tracking-[0.12em]" aria-label="Open menu">Menu</summary>
            <nav class="absolute right-0 mt-3 w-64 rounded-[2px] border border-rule bg-card p-2 text-ink" aria-label="Mobile">
              {nav.map((n) => <a href={n.href} class="block px-4 py-3 font-semibold hover:bg-paper">{n.label}</a>)}
              <a href="/contact#trial" class="mt-1 block bg-gold px-4 py-3 font-semibold text-ink">Book a Free Session</a>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="paper border-t border-rule bg-paper text-ink-soft pb-28 lg:pb-10">
      <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr]">
        <div>
          <img src="/brand/logo.png" alt="Hanma Fitness Studio" width="200" height="120" class="h-auto w-[200px]" loading="lazy" />
          <p class="mt-4 max-w-sm">The best gym in Gulistan e Johar (Gulistan e Jauhar) for coached training. A coaching first studio, with coaches on the floor morning, afternoon and evening, Monday to Friday.</p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a class="btn btn-gold !min-h-11" href={waLink('Hi Hanma, I would like to book a free session')} data-wa>WhatsApp Us</a>
            <a class="btn btn-line !min-h-11" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
          </div>
        </div>
        <div>
          <p class="eyebrow">Hours</p>
          <dl class="mt-4 text-[1rem]">
            {hoursSummary.map((h) => (
              <div class="flex justify-between gap-4 border-b border-rule py-1.5"><dt>{h.label}</dt><dd class="text-ink text-right">{h.time}</dd></div>
            ))}
          </dl>
        </div>
        <div>
          <p class="eyebrow">Explore</p>
          <ul class="mt-4 grid gap-1.5">
            {programmes.map((p) => <li><a class="underline-offset-4 hover:text-ink hover:underline" href={`/services/${p.slug}`}>{p.name}</a></li>)}
            <li><a class="underline-offset-4 hover:text-ink hover:underline" href="/pricing">Gym fees</a></li>
            <li><a class="underline-offset-4 hover:text-ink hover:underline" href="/guides">Guides</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Find Us</p>
          <p class="mt-4">{business.addressLine}</p>
          <p class="mt-2"><a class="underline underline-offset-4 hover:text-ink" href={business.mapsUrl}>Open in Google Maps</a></p>
          <p class="mt-2"><a class="underline underline-offset-4 hover:text-ink" href={business.instagram}>Instagram {business.instagramHandle}</a></p>
          <p class="mt-2"><a class="underline underline-offset-4 hover:text-ink" href={`mailto:${business.email}`}>{business.email}</a></p>
        </div>
      </div>
      <div class="wrap cond flex flex-wrap justify-between gap-2 border-t border-rule pt-6 text-[0.85rem] uppercase tracking-[0.14em] text-stone">
        <span>Hanma Fitness Studio · Gulistan e Johar · Karachi</span>
        <span>Since 2023 · © {new Date().getFullYear()}</span>
      </div>
    </footer>

    <!-- Mobile action bar: the two things a visitor wants, always in reach -->
    <div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-ink/95 p-3 backdrop-blur lg:hidden" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
      <div class="grid grid-cols-[1fr_auto] gap-2">
        <a class="btn btn-gold w-full" href={waLink('Hi Hanma, I would like to book a free session')} data-wa data-track="sticky_whatsapp">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3.1 0-1.5.8-2.2 1.1-2.5.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 1.9 1.1 1 2 1.3 2.3 1.4.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
          Book a Free Session
        </a>
        <a class="btn btn-line w-[3.25rem] !px-0" href={`tel:${business.phoneTel}`} aria-label={`Call ${business.phoneDisplay}`} data-track="sticky_call">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-current"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
        </a>
      </div>
    </div>

    <LeadPrompts client:idle />

    <!-- Subtle 3D tilt on cards for mouse users; off for touch and reduced motion -->
    <script is:inline>
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll('video[autoplay]').forEach(function (v) { v.pause(); v.controls = true; });
        if (!matchMedia('(pointer: fine)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.addEventListener('pointermove', function (e) {
          var el = e.target.closest && e.target.closest('[data-tilt]');
          document.querySelectorAll('[data-tilt][data-tilting]').forEach(function (o) {
            if (o !== el) { o.style.transform = ''; o.removeAttribute('data-tilting'); }
          });
          if (!el) return;
          var r = el.getBoundingClientRect();
          var x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
          var max = el.offsetHeight > 200 ? 6 : 2.5;
          el.setAttribute('data-tilting', '');
          el.style.transform = 'perspective(900px) rotateX(' + (-y * max).toFixed(2) + 'deg) rotateY(' + (x * max).toFixed(2) + 'deg)';
        }, { passive: true });
      })();
    </script>

    <!-- Blur fade on scroll and number tickers (Magic UI), plain JS -->
    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) return;
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (!e.isIntersecting) return;
            var el = e.target; io.unobserve(el);
            if (el.hasAttribute('data-reveal')) el.classList.add('in');
            if (el.hasAttribute('data-count') && !still) count(el);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        function count(el) {
          var end = parseFloat(el.getAttribute('data-count')), dec = +(el.getAttribute('data-decimals') || 0), from = parseFloat(el.getAttribute('data-from') || '0');
          var suffix = el.getAttribute('data-suffix') || '', t0 = performance.now(), dur = 1600;
          (function step(t) {
            var p = Math.min(1, (t - t0) / dur), k = p === 1 ? 1 : 1 - Math.pow(2, -10 * p);
            el.textContent = (from + (end - from) * k).toFixed(dec) + suffix;
            if (p < 1) requestAnimationFrame(step);
          })(t0);
        }
        document.querySelectorAll('[data-reveal-stagger]').forEach(function (g) {
          Array.prototype.forEach.call(g.children, function (c, i) { c.setAttribute('data-reveal', ''); c.style.setProperty('--d', Math.min(i, 8) * 90 + 'ms'); });
        });
        document.querySelectorAll('[data-reveal],[data-count]').forEach(function (el) { io.observe(el); });
      })();
    </script>

    <!-- Lead source: tags every WhatsApp link and form with where the visitor came from -->
    <script is:inline>
      (function () {
        var src = null;
        try {
          var q = new URLSearchParams(location.search);
          var utm = (q.get('utm_source') || '').toLowerCase();
          var camp = (q.get('utm_campaign') || '').toLowerCase();
          var code = null;
          if (q.get('gclid') || q.get('gbraid') || q.get('wbraid') || utm === 'google') {
            code = camp.indexOf('pmax') > -1 || camp.indexOf('performance') > -1 ? 'G1'
                 : camp.indexOf('smart') > -1 ? 'G2'
                 : camp.indexOf('search') > -1 ? 'G3' : 'G';
          } else if (utm.indexOf('insta') > -1 || utm === 'ig') code = 'IG';
          else if (utm.indexOf('facebook') > -1 || utm === 'fb') code = 'FB';
          else if (utm) code = utm.slice(0, 10).toUpperCase();
          if (code) {
            src = { code: code, utm_source: utm, utm_campaign: camp, gclid: q.get('gclid') || '', landing: location.pathname };
            sessionStorage.setItem('hanma_src', JSON.stringify(src));
          } else {
            src = JSON.parse(sessionStorage.getItem('hanma_src') || 'null');
          }
        } catch (e) {}
        window.hanmaSource = src || { code: 'WEB', landing: location.pathname };
        var c = window.hanmaSource.code;
        if (c && c !== 'WEB') {
          document.querySelectorAll('a[data-wa]').forEach(function (a) {
            a.href = a.href.replace(/Ref%20WEB$/, 'Ref%20' + encodeURIComponent(c));
          });
        }
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a');
          if (!a || typeof gtag !== 'function') return;
          if (a.hasAttribute('data-wa')) gtag('event', 'whatsapp_click', { link_id: a.getAttribute('data-track') || 'whatsapp', source_code: c });
          else if (a.href && a.href.indexOf('tel:') === 0) gtag('event', 'phone_click', { link_id: a.getAttribute('data-track') || 'phone' });
        });
      })();
    </script>
  </body>
</html>
