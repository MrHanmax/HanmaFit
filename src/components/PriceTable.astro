---
import { pricing, admission } from '../data/site';
const n = (v: number) => v.toLocaleString('en-PK');
---
<div class="grid gap-10">
  {pricing.map((g) => (
    <section>
      <h3 class="text-3xl">{g.group}</h3>
      <table class="mt-4 w-full border-collapse text-left">
        <thead class="sr-only"><tr><th>Plan</th><th>Monthly</th><th>Quarterly</th></tr></thead>
        <tbody>
          {g.items.map((p) => (
            <tr class="border-t border-rule align-top">
              <th scope="row" class="py-4 pr-4 font-normal">
                <span class="block text-lg font-semibold">{p.name}</span>
                {p.note && <span class="block text-sm text-steel">{p.note}</span>}
              </th>
              <td class="py-4 pr-2 text-right whitespace-nowrap">
                {p.monthly ? <><span class="price text-2xl">{n(p.monthly)}</span><span class="block text-xs text-steel">a month</span></>
                  : p.once ? <><span class="price text-2xl">{n(p.once)}</span><span class="block text-xs text-steel">{g.group === 'Gym access' ? 'per day' : 'one time'}</span></>
                  : <span class="text-steel">Ask us</span>}
              </td>
              <td class="hidden py-4 pl-4 text-right whitespace-nowrap sm:table-cell">
                {p.quarterly ? <><span class="price text-2xl">{n(p.quarterly)}</span><span class="block text-xs font-semibold text-gold-ink">{p.save} over 3 months</span></> : <span class="text-steel">·</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {g.items.some((p) => p.quarterly) && (
        <p class="mt-2 text-sm text-steel sm:hidden">Quarterly: {g.items.filter((p) => p.quarterly).map((p) => `${p.name} ${n(p.quarterly!)} (${p.save})`).join(', ')}.</p>
      )}
    </section>
  ))}
  <p class="rounded-2xl bg-chalk p-5 text-[0.95rem]"><strong>Admission {n(admission.fee)}.</strong> {admission.note} All prices in PKR, paid in advance. Quarterly plans run for 90 days.</p>
</div>
