---
import { img, results, business, onlineCoachingUrl } from '../data/site';
const { talal, amna, studioGroup, bushra } = results;
---
<div class="grid gap-6 lg:grid-cols-2">
  <figure class="overflow-hidden rounded-[2px] bg-ink border border-line">
    <img src={img(talal.photo)} alt="Talal before and after training at Hanma, June 2023 to May 2024" loading="lazy" class="aspect-[4/3] w-full object-cover" />
    <figcaption class="p-6">
      <p class="text-sm text-muted">{talal.name}, {talal.period}</p>
      <p class="mt-1 text-3xl text-cream">{talal.headline}</p>
      <blockquote class="mt-3 text-muted">“{talal.quote}”</blockquote>
    </figcaption>
  </figure>
  <figure class="overflow-hidden rounded-[2px] bg-ink border border-line">
    <div class="grid grid-cols-2 gap-0.5">
      <div class="relative"><img src={img(amna.before)} alt="Amna before training at Hanma" loading="lazy" class="aspect-[3/4] w-full object-cover" /><span class="absolute left-3 top-3 rounded-[2px] bg-ink px-2.5 py-1 cond text-[0.85rem] font-semibold uppercase tracking-[0.14em] text-cream">Before</span></div>
      <div class="relative"><img src={img(amna.after)} alt="Amna after training at Hanma" loading="lazy" class="aspect-[3/4] w-full object-cover" /><span class="absolute left-3 top-3 rounded-[2px] bg-gold px-2.5 py-1 cond text-[0.85rem] font-semibold uppercase tracking-[0.14em] text-ink">After</span></div>
    </div>
    <figcaption class="p-6">
      <p class="text-sm text-muted">{amna.name}</p>
      <p class="mt-1 text-3xl text-cream">{amna.headline}</p>
      <blockquote class="mt-3 text-muted">“{amna.quote}”</blockquote>
    </figcaption>
  </figure>
</div>
<div class="mt-6 grid items-center gap-6 overflow-hidden rounded-[2px] bg-ink border border-line md:grid-cols-[1.3fr_1fr]">
  <a href={`https://www.youtube.com/watch?v=${business.youtubeNabeel}`} class="group relative block aspect-video bg-black" aria-label="Watch Nabeel's story on YouTube">
    <img src={`https://i.ytimg.com/vi/${business.youtubeNabeel}/hqdefault.jpg`} alt="" loading="lazy" class="h-full w-full object-cover opacity-80 transition-opacity group-hover:opacity-100" />
    <span class="absolute inset-0 m-auto flex h-16 w-16 items-center justify-center rounded-full bg-gold text-ink" aria-hidden="true">
      <svg viewBox="0 0 24 24" class="ml-1 h-7 w-7 fill-current"><path d="M8 5v14l11-7z"/></svg>
    </span>
  </a>
  <div class="p-6 md:pr-8">
    <p class="text-sm text-muted">Nabeel, in his own words</p>
    <p class="mt-1 text-3xl text-cream">From complete beginner to fitness enthusiast</p>
    <a class="mt-4 inline-block font-semibold text-cream underline underline-offset-4" href={`https://www.youtube.com/watch?v=${business.youtubeNabeel}`}>Watch his story</a>
  </div>
</div>
<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <figure class="overflow-hidden rounded-[2px] bg-ink border border-line">
    <div class="grid grid-cols-2 gap-0.5">
      <div class="relative"><img src={studioGroup.before} alt="Studio group training member before" loading="lazy" class="aspect-[3/4] w-full object-cover" /><span class="absolute left-3 top-3 rounded-[2px] bg-ink px-2.5 py-1 cond text-[0.85rem] font-semibold uppercase tracking-[0.14em] text-cream">Before</span></div>
      <div class="relative"><img src={studioGroup.after} alt="Studio group training member after" loading="lazy" class="aspect-[3/4] w-full object-cover" /><span class="absolute left-3 top-3 rounded-[2px] bg-gold px-2.5 py-1 cond text-[0.85rem] font-semibold uppercase tracking-[0.14em] text-ink">After</span></div>
    </div>
    <figcaption class="p-6">
      <p class="text-3xl text-cream">{studioGroup.headline}</p>
      <p class="mt-2 text-muted">{studioGroup.caption}</p>
    </figcaption>
  </figure>
  <a href={bushra.url} class="group flex flex-col overflow-hidden rounded-[2px] bg-ink border border-line">
    <div class="relative">
      <img src={bushra.poster} alt="Bushra recording her testimonial" loading="lazy" class="aspect-[4/3] w-full object-cover opacity-90 transition-opacity group-hover:opacity-100" />
      <span class="absolute inset-0 m-auto flex h-16 w-16 items-center justify-center rounded-full bg-gold text-ink" aria-hidden="true"><svg viewBox="0 0 24 24" class="ml-1 h-7 w-7 fill-current"><path d="M8 5v14l11-7z"/></svg></span>
    </div>
    <div class="p-6">
      <p class="text-3xl text-cream">“{bushra.quote}”</p>
      <p class="mt-2 text-muted">{bushra.name}. Watch her testimonial</p>
    </div>
  </a>
</div>
<p class="mt-8 text-muted">Not in Karachi? Fawad also coaches online, worldwide. <a class="font-semibold text-cream underline underline-offset-4" href={onlineCoachingUrl}>See Hanma online coaching</a>.</p>
