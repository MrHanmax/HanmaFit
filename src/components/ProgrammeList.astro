---
import { programmes } from '../data/site';
---
<ul class="grid gap-3">
  {programmes.map((p, i) => (
    <li>
      <a href={`/services/${p.slug}`} data-tilt class="group grid gap-3 rounded-[2px] border border-line bg-raised p-5 transition-colors hover:border-gold md:grid-cols-[1.1fr_1.5fr_auto] md:items-center md:gap-8 md:p-6">
        <div>
          <h3 class="text-[2rem] group-hover:underline decoration-gold decoration-2 underline-offset-[6px]">{p.name}</h3>
          {p.tone === 'women' && <p class="cond mt-1 text-[0.9rem] font-semibold uppercase tracking-[0.14em] text-gold">Women only</p>}
        </div>
        <div>
          <p>{p.short}</p>
          <p class="text-base text-muted">{p.when}</p>
        </div>
        <p class="md:text-right"><span class="cond text-sm uppercase tracking-[0.12em] text-muted">from</span> <span class="price text-2xl">{p.from}</span></p>
      </a>
    </li>
  )).flatMap((li, i) => programmes[i].slug === 'group-classes' ? [li, (
    <li>
      <a href="/pricing" data-tilt class="group grid gap-3 rounded-[2px] border border-line bg-raised p-5 transition-colors hover:border-gold md:grid-cols-[1.1fr_1.5fr_auto] md:items-center md:gap-8 md:p-6">
        <div><h3 class="text-[2rem] group-hover:underline decoration-gold decoration-2 underline-offset-[6px]">Basic membership</h3></div>
        <div>
          <p>Train on your own, with floor staff on hand.</p>
          <p class="text-base text-muted">Quarterly 15,000, no admission fee</p>
        </div>
        <p class="md:text-right"><span class="cond text-sm uppercase tracking-[0.12em] text-muted">from</span> <span class="price text-2xl">7,000 a month</span></p>
      </a>
    </li>
  )] : [li])}
</ul>
