---
import { programmes } from '../data/site';
const tones = {
  coed: 'bg-iron',
  women: 'bg-plum',
  mma: 'bg-red',
  health: 'bg-steel',
} as const;
---
<ul class="divide-y divide-rule border-y border-rule">
  {programmes.map((p) => (
    <li>
      <a href={`/services/${p.slug}`} class="group grid gap-3 py-6 md:grid-cols-[1.1fr_1.4fr_auto] md:items-center md:gap-8">
        <div class="flex items-center gap-4">
          <span class:list={['h-10 w-1.5 shrink-0 rounded-full', tones[p.tone]]} aria-hidden="true"></span>
          <h3 class="text-[2.1rem] group-hover:underline decoration-2 underline-offset-4">{p.name}</h3>
        </div>
        <div class="pl-[1.375rem] md:pl-0">
          <p class="font-semibold">{p.short}</p>
          <p class="text-[0.95rem] text-steel">{p.when}</p>
        </div>
        <p class="pl-[1.375rem] md:pl-0 md:text-right"><span class="text-steel text-sm">from</span> <span class="price text-2xl">{p.from}</span></p>
      </a>
    </li>
  ))}
</ul>
