---
import TrialForm from './TrialForm';
import SectionHead from './SectionHead.astro';
import { faqs, waLink } from '../data/site';
interface Props { goal?: string; heading?: string; showFaq?: boolean }
const { goal, heading = 'Your First Session Is Free', showFaq = true } = Astro.props;
---
<section id="trial" class="scroll-mt-24 border-y border-line bg-raised py-16 md:py-24">
  <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.05fr] lg:items-start">
    <div>
      <SectionHead eyebrow="Book" title={heading} dek="Tell us what you want and when you can train. We confirm a time on WhatsApp and pair you with the right coach." />
      <p class="mt-5 text-muted">Prefer to message? <a class="font-semibold text-cream underline decoration-gold decoration-2 underline-offset-[6px]" href={waLink('Hi Hanma, I would like to book a free session')} data-wa data-track="trial_section_whatsapp">WhatsApp us directly</a>.</p>
      {showFaq && (
        <div class="mt-10 border-t border-line">
          {faqs.map((f) => (
            <details class="group border-b border-line py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
                {f.q}
                <span class="text-2xl text-gold transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-2 text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      )}
    </div>
    <div>
      <TrialForm client:visible defaultGoal={goal} />
    </div>
  </div>
  <!-- Static copy of the form so Netlify registers it at build time -->
  <form name="trial" data-netlify="true" netlify-honeypot="bot-field" hidden>
    <input name="bot-field" /><input name="name" /><input name="whatsapp" /><input name="goal" /><input name="time" />
    <input name="source" /><input name="utm_source" /><input name="utm_campaign" /><input name="gclid" /><input name="landing" />
  </form>
</section>
