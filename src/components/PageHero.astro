---
import SectionHead from './SectionHead.astro';
interface Props { title: string; lede: string; eyebrow?: string; tone?: string }
const { title, lede, eyebrow = 'Hanma Fitness Studio' } = Astro.props;
---
<section class="pt-12 pb-10 md:pt-20 md:pb-14">
  <div class="wrap">
    <SectionHead as="h1" eyebrow={eyebrow} title={title} dek={lede} />
    <slot />
  </div>
</section>
